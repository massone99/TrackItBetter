{
  "expo": {
    "name": "TrackItBetter",
    "slug": "track-it-better",
    "scheme": "trackitbetter",
    "version": "0.17.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackitbetter.app",
      "buildNumber": "60"
    },
    "android": {
      "package": "com.trackitbetter.app",
      "versionCode": 70,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F45C8"
      },
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withMainActivityConfigChanges",
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TrackItBetter to access progress photos and form-check videos you choose.",
          "cameraPermission": "Allow TrackItBetter to take progress photos and record form-check videos."
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2F45C8"
        }
      ],
      "react-native-fast-tflite",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "icon": "./assets/images/icon.png"
  }
}
